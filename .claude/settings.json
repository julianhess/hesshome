{
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033Ptmux;\\033\\033]9;%s\\007\\033\\\\' \"Claude needs you\" > \"/dev/$(ps -o tty= -p $PPID | tr -d ' ')\""
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "copyOnSelect": false,
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": ""
  }
}
